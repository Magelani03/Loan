generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  name             String?
  surname          String?
  email            String   @unique
  password         String
  idNumber         String?
  age              Int?
  gender           String?
  physicalAddress  String?
  telephone        String?
  employmentStatus String?
  employer         String?
  jobTitle         String?
  incomePerAnnum   Float?
  bankName         String?
  accountHolder    String?
  accountNumber    String?
  accountType      String?
  branchCode       String?
  createdAt        DateTime @default(now())

  loans     Loan[]
  documents Document[]
  guarantors Guarantor[]
}

model Loan {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  amount            Float
  interestRate      Float
  repaymentPeriod   Int
  installmentAmount Float?
  nextPaymentDue    DateTime?
  dueDate           DateTime
  status            String    @default("pending")
  referenceNumber   String    @unique @default(cuid())
  dateApplied       DateTime  @default(now())
  messages          Json?
  periodMonths      Int
}

model Document {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  type       String
  url        String
  uploadedAt DateTime @default(now())
}

model Guarantor {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  name    String
  contact String
}