datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ──────────────────────────────────────────────────────────────
// USER
// ──────────────────────────────────────────────────────────────
model User {
  id               String   @id @default(cuid())
  name             String?
  surname          String?
  email            String   @unique
  password         String
  idNumber         String?
  age              Int?
  gender           String?
  physicalAddress  String?
  telephone        String?
  employmentStatus String?
  employer         String?
  jobTitle         String?
  incomePerAnnum   Float?
  bankName         String?
  accountHolder    String?
  accountNumber    String?
  accountType      String?
  branchCode       String?
  createdAt        DateTime @default(now())

  // Relations
  loans            Loan[]
  documents        Document[]
  guarantors       Guarantor[]
}

// ──────────────────────────────────────────────────────────────
// LOAN
// ──────────────────────────────────────────────────────────────
model Loan {
  id               String   @id @default(cuid())
  user             User     @relation(fields: [userId], references: [id])
  userId           String
  amount           Float
  interestRate     Float
  repaymentPeriod  Int      // months
  installmentAmount Float?
  nextPaymentDue   DateTime?
  dueDate          DateTime
  status           String   @default("pending") // pending, approved, rejected, ongoing, complete, sent
  referenceNumber  String   @unique @default(cuid())
  dateApplied      DateTime @default(now())
  messages         Json?    // array of strings

  // Optional: loan type (1, 3, 5 months)
  periodMonths     Int
}

// ──────────────────────────────────────────────────────────────
// DOCUMENT UPLOADS
// ──────────────────────────────────────────────────────────────
model Document {
  id                String  @id @default(cuid())
  user              User    @relation(fields: [userId], references: [id])
  userId            String
  type              String  // "id" | "payslip" | "bank_statement" | "proof_residence"
  url               String
  uploadedAt        DateTime @default(now())
}

// ──────────────────────────────────────────────────────────────
// GUARANTOR
// ──────────────────────────────────────────────────────────────
model Guarantor {
  id         String  @id @default(cuid())
  user       User    @relation(fields: [userId], references: [id])
  userId     String
  name       String
  contact    String
}